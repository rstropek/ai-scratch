{
  "name": "digiferien-ki-scratch",
  "private": true,
  "version": "0.1.0",
  "description": "Scratch 3 editor with a German AI chat assistant for the Digiferien workshop",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,vite -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch src/server/main.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build && node scripts/prepare-scratch.ts",
    "start": "node src/server/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "biome check . && tsc -b",
    "lint:fix": "biome check --write .",
    "postinstall": "node scripts/fix-vm-node.ts",
    "eval:guard": "node --env-file=.env eval/guard/run.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.87",
    "@azure/identity": "4.14.0",
    "@azure/storage-blob": "12.34.0",
    "@hono/node-server": "2.1.5",
    "ai": "7.0.150",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ai-sdk/react": "4.0.154",
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@scratch/scratch-gui": "15.3.0",
    "@scratch/scratch-storage": "15.3.0",
    "@scratch/scratch-vm": "15.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "concurrently": "10.0.6",
    "dompurify": "3.4.17",
    "jsdom": "30.1.3",
    "lucide-react": "1.61.0",
    "marked": "18.1.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
