{
  "name": "ai-scratch",
  "private": true,
  "description": "AI-Scratch: the kids' app (apps/app, ai-scratch.dev) and the teachers' office (apps/office, office.ai-scratch.dev)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/app",
    "apps/office"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/app",
    "dev:office": "npm run dev -w apps/office",
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces --if-present",
    "check": "biome check . && npm run typecheck --workspaces",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2"
  },
  "allowScripts": {
    "core-js": false,
    "esbuild": false
  }
}
