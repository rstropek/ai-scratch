{
  "name": "@ai-scratch/office",
  "private": true,
  "version": "0.1.0",
  "description": "The teachers' office: applications, access codes, admin (office.ai-scratch.dev)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build && cp -r .next/static .next/standalone/apps/office/.next/",
    "start": "node --env-file-if-exists=.env .next/standalone/apps/office/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "auth:schema": "auth generate --config scripts/auth-cli.config.ts --output ../../packages/db/src/schema/auth.ts --yes",
    "test": "vitest run",
    "e2e": "playwright test",
    "seed:admin": "node --env-file-if-exists=.env scripts/seed-admin.ts"
  },
  "dependencies": {
    "@ai-scratch/db": "0.1.0",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "auth": "1.7.14",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
