# the local Postgres from compose.yaml (docker compose up -d db, at the repo root)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aiscratch
# at least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3100

# mails as JSON files in this folder instead of sending them; in production RESEND_API_KEY instead
MAIL_OUTBOX_DIR=mail-outbox
# RESEND_API_KEY=
# MAIL_FROM=AI-Scratch <office@mail.ai-scratch.dev>
# who hears about new teacher applications (default: Rainer)
# ADMIN_NOTIFY_EMAIL=

# Cloudflare's dummy Turnstile keys (always pass); never the real ones outside production
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Jev screens teacher applications; JEV_DISABLED=1 lets them through unchecked (local development)
JEV_DISABLED=1
# JEV_API_KEY=
# JEV_MODEL=jev-1.13.0

# seals the Anthropic keys of the pool in the database (both apps read it): openssl rand -base64 32
KEY_ENCRYPTION_KEY=

# checks federated pool entries with your az login (docs/anthropic-federation.md, local debugging); on Azure
# provision.sh sets the audience and ANTHROPIC_FEDERATION_CLIENT_ID (the managed identity) instead
# ANTHROPIC_FEDERATION_AUDIENCE=api://095dcf0d-0152-4de4-82b2-0cf51019cd56
# ANTHROPIC_FEDERATION_TENANT_ID=022e4faf-c745-475a-be06-06b1e1c9e39d
