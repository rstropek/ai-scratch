# Codes from the office: the shared database (local: docker compose up -d db at the root) and the master key of the
# sealed keys, the same value as the office's .env. Leave DATABASE_URL empty to run with TEST_CODES only.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aiscratch
KEY_ENCRYPTION_KEY=
# dev and tests only, never on Azure: comma-separated codes without a database, paid with ANTHROPIC_API_KEY;
# codes starting with admin_ have no hearts
TEST_CODES=test
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
# federated pool entries (docs/anthropic-federation.md): locally your az login gets the token
ANTHROPIC_FEDERATION_AUDIENCE=
# TypeSafe key for the kids-protection guard (Jev)
JEV_API_KEY=
# the 80 % budget warnings to the admins; without it they only go to the log
RESEND_API_KEY=
# the budgets, the same as the office's (defaults shown)
# BUDGET_TOTAL_USD_MONTH=100
# BUDGET_ACCOUNT_USD_MONTH=10
# FREE_CODES_PER_ACCOUNT_MONTH=5
# CODE_BUDGET_USD=5
# CODE_MAX_HOURS=4
# only for npm run test:live: an OpenRouter key with a spending limit, stored behind a test code in memory
OPENROUTER_API_KEY=
