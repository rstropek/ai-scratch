{
  "root": false,
  "extends": "//",
  "files": {
    "includes": ["**", "!**/*.md", "!public/scratch", "!.impeccable"]
  },
  "overrides": [
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          }
        }
      }
    }
  ]
}
